{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiveTranslate",
  "version": "0.5.1",
  "identifier": "com.livetranslate.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "LiveTranslate",
        "width": 480,
        "height": 760,
        "resizable": true,
        "maximizable": false,
        "minWidth": 420,
        "minHeight": 680
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "",
        "width": 720,
        "height": 130,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$TEMP/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../python": "python",
      "tools/rcedit-x64.exe": "rcedit.exe",
      "icons/icon.ico": "app-icon.ico"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/NBS282/LiveTranslate/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwNkJCN0I0QTY4QkEyQkIKUldTN29vdW10TGRyUU9pMFoyRFdVaVJvWG9PM0wrVWhHQ3pJbnppWU1qZUlNUVE4djh6eURyK2QK"
    }
  }
}
